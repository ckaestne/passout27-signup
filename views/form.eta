<% layout('./layout') %>
<%
  const money = p => (p < 0 ? '−$' : '+$') + Math.abs(p);
  const group = g => it.options.filter(o => o.group === g);
  const fee = id => it.options.find(o => o.id === id);
  const registration = fee('registration');
  const eventFull = registration.left === 0;
  const days = it.days;
%>

<div class="box">
  <h1 class="title"><%= it.config.title %></h1>
  <div class="content"><%~ it.texts.intro %></div>
  <% if (!eventFull) { %><p class="has-text-danger is-size-7">* Indicates required question</p><% } %>
</div>

<% if (eventFull) { %>
  <div class="notification is-warning">The event is full. Please contact the organizers.</div>
<% } else { %>

<form method="post" action="/register" id="form">
  <script type="application/json" id="fees"><%~ JSON.stringify({
    registration: registration.price, missedNight: fee('missed_night').price, shortNight: fee('short_night').price,
    deposit: it.config.deposit }) %></script>
  <input type="text" name="website" class="is-hidden" tabindex="-1" autocomplete="off">
  <input type="hidden" name="price_total">
  <input type="hidden" name="price_lines">

  <div class="box mt-6">
    <h2 class="title is-4">About PassOut</h2>
    <div class="content"><%~ it.texts.about %></div>
  </div>

  <div class="box mt-6">
    <h2 class="title is-4">About you</h2>
  </div>
  <div class="box">
    <label class="label" for="email">Email <span class="has-text-danger">*</span></label>
    <input class="input is-primary" type="email" id="email" name="email" required>
  </div>
  <div class="box">
    <label class="label" for="name">Your name <span class="has-text-danger">*</span></label>
    <input class="input is-primary" id="name" name="name" required>
  </div>
  <div class="box">
    <label class="label" for="phone">Your phone number</label>
    <input class="input is-primary" type="tel" id="phone" name="phone">
    <p class="help">For coordinating pickups and emergencies only.</p>
  </div>
  <div class="box">
    <label class="label" for="last_passout">What was the last PassOut you attended?</label>
    <input class="input is-primary" id="last_passout" name="last_passout">
    <p class="help">If this is your first PassOut, let us know how you heard about PassOut.</p>
  </div>

  <div class="box mt-6">
    <h2 class="title is-4">Accommodations</h2>
    <div class="content"><%~ it.texts.accommodations %></div>
  </div>
  <div class="box" role="radiogroup" aria-labelledby="sleeping-label">
    <p class="label" id="sleeping-label">Accommodation preferences <span class="has-text-danger">*</span></p>
    <div class="radios is-flex-direction-column">
    <% group('sleeping').forEach(o => { %>
      <label class="radio"<%= o.left === 0 ? ' disabled' : '' %>>
        <input type="radio" name="sleeping" value="<%= o.id %>" data-price="<%= o.price %>" data-label="<%= o.label %>" required<%= o.left === 0 ? ' disabled' : '' %>>
        <%= o.label %><% if (o.price) { %> <span class="has-text-weight-semibold">(<%= money(o.price) %>)</span><% } %>
        <% if (o.left === 0) { %><span class="tag is-danger is-light ml-1">full</span>
        <% } else if (o.left !== undefined) { %><span class="tag is-success is-light ml-1"><%= o.left %> of <%= o.quantity %> left</span><% } %>
      </label>
    <% }) %>
    </div>
  </div>
  <div class="box">
    <label class="label" for="accommodation_comments">Comments on accommodations</label>
    <textarea class="textarea is-primary" id="accommodation_comments" name="accommodation_comments" rows="2"></textarea>
    <p class="help">E.g., request accommodations, relative preferences.</p>
  </div>

  <div class="box mt-6">
    <h2 class="title is-4">Scholarship program</h2>
    <div class="content"><%~ it.texts.scholarship %></div>
  </div>
  <div class="box" role="radiogroup" aria-labelledby="discount-label">
    <p class="label" id="discount-label">Discounts and supports <span class="has-text-danger">*</span></p>
    <div class="radios is-flex-direction-column">
    <% group('discount').forEach(o => { %>
      <label class="radio">
        <input type="radio" name="discount" value="<%= o.id %>" data-price="<%= o.price %>" data-kind="<%= o.kind || '' %>" data-label="<%= o.label %>" required>
        <%= o.label %><% if (o.price) { %> <span class="has-text-weight-semibold">(<%= money(o.price) %>)</span><% } %>
      </label>
    <% }) %>
    </div>
  </div>

  <div class="box mt-6">
    <h2 class="title is-4">Dates and transportation</h2>
    <div class="content"><%~ it.texts.dates %></div>
  </div>
  <div class="box">
    <div class="columns">
      <div class="column">
        <label class="label" for="arrive">When do you plan to arrive?</label>
        <div class="select is-primary is-fullwidth"><select id="arrive" name="arrive">
          <% days.slice(0, -1).forEach((d, i) => { %>
            <option value="<%= d.value %>"><%= d.label %><% if (i) { %> (<%= i %> night<%= i > 1 ? 's' : '' %> less)<% } %></option>
          <% }) %>
        </select></div>
      </div>
      <div class="column">
        <label class="label" for="leave">When do you plan to leave?</label>
        <div class="select is-primary is-fullwidth"><select id="leave" name="leave">
          <% days.slice(1).reverse().forEach((d, i) => { %>
            <option value="<%= d.value %>"><%= d.label %><% if (i) { %> (<%= i %> night<%= i > 1 ? 's' : '' %> less)<% } %></option>
          <% }) %>
        </select></div>
      </div>
    </div>
  </div>
  <div class="box" role="radiogroup" aria-labelledby="transport-label">
    <p class="label" id="transport-label">How will you arrive?</p>
    <div class="radios is-flex-direction-column">
    <% it.config.transportOptions.forEach(t => { %>
      <label class="radio"><input type="radio" name="transport" value="<%= t %>"> <%= t %></label>
    <% }) %>
    </div>
  </div>
  <div class="box">
    <label class="label" for="transport_comments">Additional information on transport</label>
    <textarea class="textarea is-primary" id="transport_comments" name="transport_comments" rows="2"></textarea>
    <p class="help">Like arrival times, if you know them already.</p>
  </div>

  <div class="box mt-6">
    <h2 class="title is-4">On site</h2>
  </div>
  <div class="box">
    <label class="label" for="diet">Dietary preferences/allergies/restrictions</label>
    <input class="input is-primary" id="diet" name="diet">
  </div>
  <div class="box">
    <label class="label" for="safety">Is there anything we should be aware of for you to feel safe and included?</label>
    <textarea class="textarea is-primary" id="safety" name="safety" rows="2"></textarea>
  </div>
  <div class="box">
    <label class="label" for="other">Anything else?</label>
    <textarea class="textarea is-primary" id="other" name="other" rows="2"></textarea>
  </div>

  <div class="box price-box mt-6">
    <table class="table is-fullwidth is-narrow mb-2"><tbody id="price-lines"></tbody></table>
    <p id="price-note" class="is-size-7 mb-3"></p>
    <button class="button is-primary is-medium" type="submit">Request registration</button>
    <p class="is-size-7 mt-2">We will follow up by email with a confirmation and information on how to pay the deposit.</p>
  </div>
</form>
<script src="/form.js"></script>
<% } %>
